# Copy this file to secrets.yaml and fill in your values.
# secrets.yaml is git-ignored — never commit real keys.

grok_api_key: ""
google_api_key: ""       # Gemini — from https://aistudio.google.com/apikey
# GCP service account JSON (Video Intelligence + Text-to-Speech)
gcp_credentials_file: "secrets/gcp-service-account.json"
# Emergent web-app DB (MongoDB Atlas connection string)
mongo_atlas_url: ""
# Optional: required only for private ntfy.sh topics
ntfy_auth_token: ""
# Dashboard auth (used when config.yaml dashboard.token is empty)
dashboard_token: ""
# Optional HMAC secret for notification action buttons (falls back to dashboard_token)
action_hmac_secret: ""
# Phase 10 Twilio "Connect me" (only if telephony.enabled)
twilio_account_sid: ""
twilio_auth_token: ""
twilio_from_number: ""   # E.164 Twilio number
owner_phone: ""          # E.164 phone to call
