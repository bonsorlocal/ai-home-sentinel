[Unit]
Description=AI Home Sentinel - security camera and AI brain
Documentation=https://github.com/bonsorlocal/ai-home-sentinel
After=network-online.target systemd-udev-settle.service
Wants=network-online.target
# Give libcamera time to enumerate CSI cameras before we open Picamera2.
ExecStartPre=/bin/sleep 15

[Service]
Type=simple
User=sentinel
Group=sentinel
WorkingDirectory=/home/sentinel/ai-home-sentinel
ExecStart=/home/sentinel/ai-home-sentinel/venv/bin/python /home/sentinel/ai-home-sentinel/run.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sentinel

# Give it up to 30 s to start before systemd marks it failed
TimeoutStartSec=30
# Give it 10 s to shut down cleanly
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
