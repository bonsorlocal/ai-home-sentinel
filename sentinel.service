[Unit]
Description=AI Home Sentinel - security camera and AI brain
Documentation=https://github.com/bonsorlocal/ai-home-sentinel
After=network-online.target systemd-udev-settle.service mnt-sentinel\x2ddata.mount
Wants=network-online.target
# Wait for USB data stick at /mnt/sentinel-data (DVR + event logs).
RequiresMountsFor=/mnt/sentinel-data

[Service]
Type=simple
User=sentinel
Group=sentinel
WorkingDirectory=/home/sentinel/ai-home-sentinel
# Give libcamera time to enumerate CSI cameras before we open Picamera2.
ExecStartPre=/bin/sleep 15
ExecStart=/home/sentinel/ai-home-sentinel/venv/bin/python /home/sentinel/ai-home-sentinel/run.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sentinel

# Camera warmup + YOLO load can exceed 30s on a cold Pi
TimeoutStartSec=120
# Give it 10 s to shut down cleanly
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
