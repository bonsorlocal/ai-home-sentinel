# AI Home Sentinel - files Git should ignore.
#
# This keeps private data (recordings, snapshots, faces, secrets) and
# throwaway files out of version control.

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Virtual environments ---
venv/
.venv/
env/

# --- Secrets / config overrides ---
.env
*.secret
secrets.yaml

# --- AI models (large files) ---
models/
*.pt
*.onnx
*.bin
*.param

# --- Saved data: keep folders, ignore their contents ---
data/sentinel.db
data/events/snapshots/*
data/events/clips/*
data/events/unknown_faces/*
data/known_faces/*

# Keep the empty folders themselves so the structure stays intact.
!data/events/snapshots/.gitkeep
!data/events/clips/.gitkeep
!data/events/unknown_faces/.gitkeep
!data/known_faces/.gitkeep

# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.log
