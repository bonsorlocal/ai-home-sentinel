# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
venv/
.venv/
env/

# Local PC overlay (webcam / Windows paths) — never deploy this to the Pi
config.local.yaml

# Emergent local env (written by scripts/run_pc_emergent.ps1)
backend/.env
frontend/build/

# Secrets - NEVER commit
secrets.yaml
secrets.yml
secrets/gcp-service-account.json
*.key
*.pem

# Data and runtime files
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Logs
*.log
logs/

# Models (large binary files - download separately)
models/*.pt
models/*.onnx
models/*.tflite

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.code-workspace

# Pytest
.pytest_cache/
.coverage
htmlcov/

# Pi deploy artifacts
*.pyc
